<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".fragments.FeedFragment">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Section -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Feed"
                     
                    android:textSize="32sp"
                     />

                <!--TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="8dp"
                    android:layout_toEndOf="@id/tvTitle"
                    android:background="@drawable/bg_tag_mint"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:text="✔ Peer Wisdom"
                    android:textColor="#047857"
                    android:textSize="11sp"
                      /-->
            </RelativeLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Exam survival hacks, portal alerts &amp; hall wisdom from senior KUETians."
                android:textColor="#64748B"
                android:textSize="12sp" />

            <!-- Green Callout Banner: Pass the Torch, Senior -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardBackgroundColor="#004D40"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎓 Earn +25 Kinship Points per verified guide"
                        android:textColor="#A7F3D0"
                        android:textSize="11sp"
                          />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Got a suggestion in mind?"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                          />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="Your wisdom might be a lifesaver for someone!"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp" />

                    <Button
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="14dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="⊕ + Share a Suggestion"
                        android:textAllCaps="false"
                        android:textColor="#004D40"
                        android:textSize="13sp"
                         
                        app:cornerRadius="10dp" />

                </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

            <!-- Search Bar -->
            <EditText
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_search_input"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawableEnd="@android:drawable/ic_menu_manage"
                android:drawablePadding="10dp"
                android:hint="Search topics, courses (CSE 3105), or hashtag"
                android:paddingHorizontal="14dp"
                 
                android:textColorHint="#94A3B8"
                android:textSize="12sp" />

            <!-- Hashtag Chips Row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_num_selected"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="5dp"
                        android:text="#All"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                          />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_num_unselected"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="#Exams"
                          
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_num_unselected"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="#LabSurvival"
                          
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_num_unselected"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="#HallLife"
                          
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:background="@drawable/bg_num_unselected"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="#PortalHacks"
                          
                        android:textSize="11sp" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- Post 1: -->
            
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/avatar1"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ahnaf"
                            app:shapeAppearanceOverlay="@style/CircularImageView" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@id/avatar1"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Muhammad Tahmid Ahnaf"
                                     
                                    android:textSize="14sp"
                                      />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_tag_light_blue"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="Top Mentor"
                                    android:textColor="#1E40AF"
                                    android:textSize="10sp"
                                      />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dept. of CSE • 1st Year (Batch 2k25)"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:src="@android:drawable/ic_menu_more"
                            app:tint="#64748B" />
                    </RelativeLayout>

                    <!-- Post Body Content -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="For Digital Signal Processing (CSE 3105): Never skip the previous 5 years' numerical sets on FFT decimation-in-time and Bilinear Z-transform. The term mid questions heavily cross-reference 2018–2021 problem sheets! Also, ensure you annotate your filter bode plots with corner frequencies before the lab viva—Sir checks those first."
                         
                        android:textSize="12sp" />

                    <!-- Post Tags -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_gray"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#CSE3105"
                              
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag_gray"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#ExamHacks"
                              
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag_gray"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#Batch2k25Guidance"
                              
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Verification Banner -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tag_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="✔ Verified by 128 students"
                        android:textColor="#1E40AF"
                        android:textSize="11sp" />

                    <!-- Engagement Bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="❤️ 184"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="💬 27"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@android:drawable/ic_menu_save"
                                app:tint="#64748B" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="14dp"
                                android:src="@android:drawable/ic_menu_share"
                                app:tint="#64748B" />
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

            <!-- Post 2: -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="16dp"
                 
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/avatar2"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerCrop"
                            android:src="@drawable/mira"
                            app:shapeAppearanceOverlay="@style/CircularImageView" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@id/avatar2"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Mobasshira Sadia Mira"
                                    
                                    android:textSize="14sp"
                                     />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="6dp"
                                    android:background="@drawable/bg_tag_amber"
                                    android:paddingHorizontal="6dp"
                                    android:paddingVertical="2dp"
                                    android:text="Rising Star"
                                    android:textColor="#B45309"
                                    android:textSize="10sp"
                                      />
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Dept. of CSE • 1st Year (Batch 2k25)"
                                android:textColor="#64748B"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_alignParentEnd="true"
                            android:src="@android:drawable/ic_menu_more"
                            app:tint="#64748B" />
                    </RelativeLayout>

                    <!-- Post Body Content -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="3dp"
                        android:text="Dining Hall Cutoff Hack: The student management portal consistently stalls around 7:52 PM every evening before the 8:00 PM cutoff time. Always mark your meal off/on before 6:30 PM! Set a daily recurring alarm at 6 PM."
                         
                        android:textSize="12sp" />

                    <!-- Post Tags -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_tag_gray"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#PortalHacks"
                              
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag_gray"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#HallLife"
                              
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_tag_gray"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="#DiningAlert"
                              
                            android:textSize="10sp" />
                    </LinearLayout>

                    <!-- Verification Banner -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_tag_green"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="5dp"
                        android:text="✔ Verified by 89 students"
                        android:textColor="#1E40AF"
                        android:textSize="11sp" />

                    <!-- Engagement Bar -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="👍 219"
                                android:textColor="#64748B"
                                android:textSize="12sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:text="💬 41"
                                android:textColor="#64748B"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@android:drawable/ic_menu_save"
                                app:tint="#64748B" />

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_marginStart="14dp"
                                android:src="@android:drawable/ic_menu_share"
                                app:tint="#64748B" />
                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>
             </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</FrameLayout>