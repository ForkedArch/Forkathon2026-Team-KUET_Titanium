<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginBottom="7dp"
    android:gravity="center_vertical"
    android:paddingHorizontal="11dp">

    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/circle_mte"
        android:gravity="center"
        android:text="CSE"

        android:textColor="@color/green"
        android:textSize="11sp"
        android:textStyle="bold"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:layout_width="140dp"
            android:layout_height="20dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Robotics &amp; Automation"
           android:fontFamily="@font/jakarta_sans_bold"
            android:textSize="13sp"
            android:textStyle="bold"/>
        <TextView
            android:layout_width="150dp"
            android:layout_height="17dp"
            android:text="▣ Mech 205  •  ◷ Ends 01:00 PM"
            android:textColor="@color/muted"
            android:textSize="8sp"/>
    </LinearLayout>

    <TextView
        android:layout_width="52dp"
        android:layout_height="27dp"
        android:background="@drawable/chip_blue"
        android:gravity="center"
        android:text="MTE-4203"
        android:textColor="@color/blue"
        android:textSize="8sp"
        android:textStyle="bold"/>
    <Space
        android:layout_width="6dp"
        android:layout_height="1dp"/>
    <TextView
        android:layout_width="68dp"
        android:layout_height="27dp"
        android:background="@drawable/chip_red"
        android:gravity="center"
        android:text="In Progress"
        android:textColor="@color/red"
        android:textSize="8sp"
        android:textStyle="bold"/>
</LinearLayout>
