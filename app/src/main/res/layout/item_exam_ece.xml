<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:layout_marginBottom="7dp"

    android:gravity="center_vertical"
    android:paddingHorizontal="11dp">
    <TextView
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/circle_ece"
        android:gravity="center"
        android:text="EEE"
        android:textColor="@color/green"
        android:textSize="11sp"
        android:textStyle="bold"/>


    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Digital Signal Processing"
            android:fontFamily="@font/jakarta_sans_bold"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="150dp"
            android:layout_height="17dp"
            android:text="▣ ECE 301  •  ◷ Ends 12:30 PM"
            android:textColor="@color/muted"
            android:textSize="10sp"/>

    </LinearLayout>
    <TextView
        android:layout_width="52dp"
    android:layout_height="27dp"
        android:background="@drawable/chip_blue"
        android:gravity="center"
    android:text="EEE-4207"
        android:textColor="@color/blue"
        android:textSize="8sp"
        android:textStyle="bold"/>

    <Space
        android:layout_width="6dp"
        android:layout_height="1dp"/>

    <TextView
        android:layout_width="68dp"
    android:layout_height="27dp"
        android:background="@drawable/chip_blue"
        android:gravity="center"
    android:text="Concluding"
        android:textColor="@color/blue"
        android:textSize="8sp"
        android:textStyle="bold"/>
</LinearLayout>
