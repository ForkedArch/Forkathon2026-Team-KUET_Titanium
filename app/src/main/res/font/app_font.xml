<?xml version="1.0" encoding="utf-8"?>

<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com">

    <!-- Regular Font -->
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/jakarta_sans_bold"
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/jakarta_sans_bold" />

    <!-- Bold Font (Optional) -->
    <font
        android:fontStyle="normal"
        android:fontWeight="700"
        android:font="@font/jakarta_sans_medium"
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/jakarta_sans_medium" />
</font-family>
