        <activity
            android:name=".consolidated.ExamsActivity"
            android:exported="false"
            android:theme="@style/Theme.KUETKinship"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ExamAndStuffActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GuidesListActivity"
            android:exported="false"
